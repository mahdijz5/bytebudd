# Development Environment (Local Backend + Local Frontend)
# Use with: set -a && source .env.dev && set +a  (Linux/Mac)
# Or run: copy .env.dev .env  (Windows)

# ── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Security (CHANGE THESE IN PRODUCTION) ────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string-here
ENCRYPTION_KEY=change-me-32-char-encryption-key!

# ── Database (PostgreSQL in Docker) ───────────────────────────────────────
# Using localhost because PostgreSQL runs in Docker and is exposed on port 5432
DATABASE_URL=postgresql+asyncpg://bytebudd:bytebudd_secret@localhost:5432/bytebudd
POSTGRES_PASSWORD=bytebudd_secret

# ── Ollama (running on host machine) ──────────────────────────────────────
# For Windows local dev, use localhost if Ollama is installed locally
# If Ollama is in Docker, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:8b
OLLAMA_TIMEOUT=120

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api

# ── RAG Service (run locally or set to Docker IP) ─────────────────────────
# If running rag-service locally: http://localhost:8081
# If running in Docker: http://host.docker.internal:8081
RAG_SERVICE_URL=http://localhost:8081

# ── Admin user ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@bytebudd.local
ADMIN_PASSWORD=change-me-on-first-login