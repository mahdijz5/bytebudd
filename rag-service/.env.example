# Port for the RAG service to listen on
PORT=8081

# Qdrant configuration
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Ollama configuration
OLLAMA_URL=http://localhost:11434

# Embedding model (must be pulled in Ollama: ollama pull <model>)
# Options: nomic-embed-text, all-minilm, embeddinggemma
EMBEDDING_MODEL=nomic-embed-text

# Chat model (must be pulled in Ollama: ollama pull <model>)
# Options: llama3, mistral, qwen2.5-coder, phi3
CHAT_MODEL=llama3

# Vector dimension (768 for nomic-embed-text, 384 for all-minilm, 768 for embeddinggemma)
VECTOR_SIZE=768

# Qdrant collection name
COLLECTION_NAME=documents

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:3000

# Text chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Number of similar chunks to retrieve for queries
TOP_K=3